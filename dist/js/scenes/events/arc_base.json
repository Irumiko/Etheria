      { "action": "send_message", "template": "Has ganado experiencia suficiente para crecer. Tu historia en Etheria acaba de empezar de verdad." }
    ]
  },

  {
    "id": "intelligence_mastery",
    "repeatable": false,
    "trigger": { "type": "stat_threshold_above", "stat": "INT", "value": 14 },
